[Unit]
Description=MSME Billing FastAPI backend
After=network.target mariadb.service

[Service]
Type=simple
User=msmebill
Group=msmebill
WorkingDirectory=/home/grovisor.co.in/apps/msme_bill_app/backend
EnvironmentFile=/home/grovisor.co.in/apps/msme_bill_app/.env
ExecStart=/home/grovisor.co.in/apps/msme_bill_app/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
